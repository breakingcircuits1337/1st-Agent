# 1st Agent Configuration

# Moonshot Kimi API Key (for high-level strategy in orchestrator)
KIMI_API_KEY=your_kimi_api_key_here

# OpenRouter API Key (for data generation during fine-tuning)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face Token (optional, for uploading models)
HF_TOKEN=your_hf_token_here

# Needle specific settings
NEEDLE_LIB_PATH=path/to/custom/needle_library
NEEDLE_HF_REPO=your_hf_username/your_repo_name

# Logging level
LOG_LEVEL=INFO

# GPU settings (if not using auto-detection)
USE_GPU=true
